{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run format*)",
      "Bash(npm audit*)",
      "Bash(npm ls*)",
      "Bash(npx prisma migrate dev)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma migrate status*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(npx vitest*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx tsc*)",
      "Bash(docker compose up)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(docker compose build)",
      "Bash(docker compose build *)",
      "Bash(docker compose config*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test*)",
      "PowerShell(npm run lint*)",
      "PowerShell(npm run typecheck*)",
      "PowerShell(npm run build*)",
      "PowerShell(npm run format*)",
      "PowerShell(npm audit*)",
      "PowerShell(npm ls*)",
      "PowerShell(npx prisma migrate dev)",
      "PowerShell(npx prisma migrate dev *)",
      "PowerShell(npx prisma migrate deploy*)",
      "PowerShell(npx prisma migrate status*)",
      "PowerShell(npx prisma generate*)",
      "PowerShell(npx prisma validate*)",
      "PowerShell(npx prisma format*)",
      "PowerShell(npx vitest*)",
      "PowerShell(npx eslint*)",
      "PowerShell(npx prettier*)",
      "PowerShell(npx tsc*)",
      "PowerShell(docker compose up)",
      "PowerShell(docker compose up *)",
      "PowerShell(docker compose down)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker compose logs *)",
      "PowerShell(docker compose build)",
      "PowerShell(docker compose build *)",
      "PowerShell(docker compose config*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.dev)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.prod)",
      "Read(./.env.staging)",
      "Read(./.env.staging.local)",
      "Read(./.env.docker)",
      "Read(./.env.ci)",
      "Read(./.env.bak)",
      "Read(./.env.*.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.docker)",
      "Read(**/.env.ci)",
      "Read(**/.env.bak)",
      "Read(**/.env.*.local)",
      "Bash(git push*)",
      "Bash(rm -rf:*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm --recursive *)",
      "Bash(rm -f -r *)",
      "PowerShell(git push*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(rm -r*)",
      "PowerShell(Remove-Item * -r*)",
      "PowerShell(Remove-Item -r*)",
      "WebFetch(domain:vnpay.vn)",
      "WebFetch(domain:*.vnpay.vn)",
      "WebFetch(domain:pay.vnpay.vn)",
      "WebFetch(domain:merchant.vnpay.vn)",
      "Bash(curl *vnpay.vn*)",
      "Bash(curl.exe *vnpay.vn*)",
      "Bash(wget *vnpay.vn*)",
      "PowerShell(Invoke-WebRequest *vnpay.vn*)",
      "PowerShell(Invoke-RestMethod *vnpay.vn*)",
      "PowerShell(curl.exe *vnpay.vn*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Read|Grep|Glob|Bash|PowerShell|WebFetch|Edit|Write|MultiEdit|NotebookEdit)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ]
  }
}
