# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env. Mọi giá trị dưới đây là placeholder.

# --- Ứng dụng ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# URL công khai của PGS (dùng tạo return URL cho VNPay)
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
# Chạy app trên máy host: dùng localhost. Trong docker compose, service api phải override
# DATABASE_URL với host "postgres" (ví dụ postgresql://pgs:change_me@postgres:5432/pgs).
DATABASE_URL=postgresql://pgs:change_me@localhost:5432/pgs
# DB riêng cho test (không dùng chung DB dev)
DATABASE_URL_TEST=postgresql://pgs:change_me@localhost:5432/pgs_test

# --- VNPay (CHỈ sandbox) ---
VNP_TMN_CODE=your_sandbox_tmn_code
VNP_HASH_SECRET=your_sandbox_hash_secret
VNP_HOST=https://sandbox.vnpayment.vn

# --- Bảo mật ---
# Khóa AES-256-GCM, 32 byte dạng base64. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace_with_32_byte_base64_key
# Khóa Admin API (header X-Admin-Key). BẮT BUỘC, >= 32 ký tự; app dừng khi khởi động nếu thiếu/ngắn. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace_with_random_admin_key_at_least_32_chars

# --- Tham số vận hành (SRS mục 7) ---
PAYMENT_TTL_SECONDS=900
QUERYDR_PENDING_AFTER_MINUTES=5
QUERYDR_INTERVAL_SECONDS=60
WEBHOOK_TIMEOUT_MS=10000
# Độ trễ (giây) cho 8 lần gửi webhook: ngay, +1m, +5m, +15m, +1h, +3h, +6h, +12h
WEBHOOK_RETRY_DELAYS=0,60,300,900,3600,10800,21600,43200
HMAC_MAX_SKEW_SECONDS=300
IDEMPOTENCY_TTL_HOURS=24
RATE_LIMIT_PER_SECOND=100
PROVIDER_TIMEOUT_MS=30000

# --- Giai đoạn 2 (deploy public qua Cloudflare Tunnel) ---
# TUNNEL_TOKEN=your_cloudflare_tunnel_token
